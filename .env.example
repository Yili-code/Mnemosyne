# Telegram: get the token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_OWNER_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# Fill this after Cloud Run returns the deployed service URL.
CLOUD_RUN_SERVICE_URL=https://your-service-url.run.app

# Gemini: create a key in Google AI Studio.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloud Scheduler sends this value in the X-Cron-Secret header.
CRON_SECRET=replace-with-another-long-random-string

# Use sqlite locally. Cloud Run must use firestore because its disk is ephemeral.
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/vocabulary.sqlite3
GOOGLE_CLOUD_PROJECT=your-project-id

# Daily review settings
REVIEW_SIZE=20
TIMEZONE=Asia/Taipei
